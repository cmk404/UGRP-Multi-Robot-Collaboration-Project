[Unit]
Description=UGRP simulation coworker UI
After=network-online.target ugrp-sim-bridge.service
Requires=ugrp-sim-bridge.service

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/projects/ugrp
ExecStart=/home/ubuntu/projects/ugrp/scripts/serve_sim_coworker.sh
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
