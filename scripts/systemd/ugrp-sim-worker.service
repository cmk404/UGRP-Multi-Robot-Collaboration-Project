[Unit]
Description=UGRP MasterPi 4DOF MuJoCo physics worker
After=network-online.target ugrp-sim-bridge.service
Requires=ugrp-sim-bridge.service

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/projects/ugrp
EnvironmentFile=/home/ubuntu/projects/ugrp/.sim_worker_env
ExecStart=/home/ubuntu/projects/ugrp/.venv-sim/bin/python /home/ubuntu/projects/ugrp/scripts/run_mujoco_worker.py --seed 11
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
