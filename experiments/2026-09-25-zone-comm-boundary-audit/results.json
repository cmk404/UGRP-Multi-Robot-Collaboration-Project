 "findings": [
  {
   "id": "L1",
   "kind": "leak",
   "severity": "high",
   "title": "independent: teacher stops a robot because a peer merely intends the same box (earlier to_box job wins), at the assignment tick",
   "evidence": [
    "scripts/zone_teacher.py:250-263",
    "scripts/zone_teacher.py:388-393",
    "scripts/run_zone_dispatch.py:230-243",
    "23/23 box_taken_by_peer stops at 0.0 s after assignment; peer phase to_box 22, grasp 1",
    "ZC2-s14-independent-nominal r2-2..r2-4 (red-1, 60.8/71.8/82.8 s) stopped while r3 was still driving; r2 reason: \"I am right beside red-1\""
   ],
   "status": "not fixed (needs a SIM fixture gate); strict xfail test tests/test_zone_comm_boundary.py::test_a_peer_intent_alone_does_not_stop_a_robot",
   "effect_on_zc2": "gives independent a first-come box lock (peer intent) it could not observe; does not create the over-delivery that failed independent, so the direction of ZC2 is not reversed, but independent is not a clean no-communication baseline and its SIM time / call counts include these stops"
  },
  {
   "id": "L2",
   "kind": "leak",
   "severity": "low",
   "title": "executor slot id from a pool shared by all robots appears in own_jobs (A3 = two other zone-A jobs)",
   "evidence": [
    "scripts/run_zone_dispatch.py:129-145",
    "scripts/run_zone_dispatch.py:203-211",
    "harness/zone_coordination.py context (before fix)",
    "independent: 36/69 own job entries carried a slot id encoding an active peer job in the same zone; no reply mentions a slot"
   ],
   "status": "fixed on this branch: harness/zone_coordination.py visible_own_jobs (box, zone, issued_at_sim_s, status) for all conditions",
   "effect_on_zc2": "no sign the model used it; ZC2 not re-run"
  },
  {
   "id": "L3",
   "kind": "leak",
   "severity": "low",
   "title": "independent request_id carried the global round counter (rises whenever any robot is asked)",
   "evidence": [
    "scripts/run_zone_dispatch.py:286-289 (turn)",
    "scripts/run_zone_dispatch.py:420-421 (phase solo-{turn})",
    "scripts/three_robot_runtime.py:141",
    "independent: 87 turn gaps in request ids across 6 runs"
   ],
   "status": "fixed on this branch: per-robot own_turns in independent_round; counterfactual tests",
   "effect_on_zc2": "weak side channel; ZC2 not re-run"
  },
  {
   "id": "L4",
   "kind": "leak (teacher condition)",
   "severity": "medium",
   "title": "executor receipts are decided from simulator truth (box z after lift, drop z, path planning on true poses, peer executor state) and reach own_jobs.status, the dynamic team_board and the wake-up rules",
   "evidence": [
    "scripts/zone_teacher.py:416-429 (lift z > .045, else retry / grasp_failed_by_teacher)",
    "scripts/zone_teacher.py:433-434 (dropped_in_transit)",
    "scripts/zone_teacher.py:376-387 (teacher_path_blocked)",
    "scripts/zone_teacher.py:454-458 (placed_by_teacher only after those checks)",
    "scripts/zone_teacher.py:244-248 (injection only keeps the gripper open)",
    "scripts/run_zone_dispatch.py:224-245 (receipt text, board reports, wake-ups)",
    "ZC2-s14-dynamic-graspfail: r1 lift checks box_z_m 0.0159 x3, failed at 31.6 s; r1 own RGB view at 31.8 s did not list green-1 in pickup"
   ],
   "status": "not fixed (needs an RGB completion check, R2 scope); disclosed as a teacher-condition input in docs/zone_dispatch.md:29",
   "effect_on_zc2": "all conditions receive it; dynamic uses peers' stopped reports and event wake-ups, so dynamic graspfail 3/3 is conditional on a reliable failure notice"
  },
  {
   "id": "L5",
   "kind": "potential leak (not triggered)",
   "severity": "low",
   "title": "slot refusal receipt in independent reveals peers' zone reservations; 3 slots per zone also cap over-delivery at 3",
   "evidence": [
    "scripts/run_zone_dispatch.py:193-202",
