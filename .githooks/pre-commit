#!/usr/bin/env bash
set -euo pipefail

# Prevent accidental Git history bloat. Heavy runtime assets belong outside Git/LFS.
limit=$((20 * 1024 * 1024))
failed=0
while IFS= read -r -d '' path; do
  [[ -z "$path" ]] && continue
  size=$(git cat-file -s ":$path" 2>/dev/null || echo 0)
  if (( size > limit )); then
    printf 'ERROR: staged file exceeds 20 MiB (%s bytes): %s\n' "$size" "$path" >&2
    failed=1
  fi
done < <(git diff --cached --name-only --diff-filter=ACM -z)

if (( failed )); then
  echo 'Move the file to runtime storage, add it to .gitignore, or explicitly adopt Git LFS.' >&2
  exit 1
fi
