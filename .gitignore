# Source/config/docs/manifests are versioned; model binaries use GitHub Releases.
# Downloaded models and runtime/build artifacts remain outside Git history.

# Python / test caches
**/__pycache__/
*.py[cod]
.pytest_cache/
.venv/
.venv-*/
.venv-real-mac
.venv-sim-worker-mac
.venv-sim-mac
.venv-lightning
.venv-sim

# OS / editor / temporary conflict copies
.DS_Store
*.orig
*.rej
*.swp
*.swo
*.sync-conflict-*

# Secrets and machine-local runtime configuration
.env
.env.*
!.env.example
*.env
!*.example.env
.webui_secret_key
.groq_keys
.sim_bridge_token
.sim_remote_url
.sim_worker_env

# Runtime outputs / traces / stress runs
outputs/
stress_logs/
*.log
MUJOCO_LOG.TXT
*.pid

# Models / large ML binaries
**/*.safetensors
**/*.gguf
**/*.bin
**/*.pt
**/*.pth
**/*.onnx
**/*.engine

# Raspberry Pi / OS image and recovery workspace is local-only.
work/
boot/

# Generic build/cache directories
build/
dist/
.cache/
tmp/

# Local agent/session state and transient sync copies
.agents/
.claude/
.codex/
.ugrp-sync-tmp/
.git.disabled-note
docs/cursor-history/
r1-nav-cam-camera-team-seed41.png
**/.git/
**/node_modules/

